# Copy to .env in the project folder. Keep all secrets out of Git.
# Username/password accounts work without these optional integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# For an HTTPS deployment only; the supplied launcher binds to localhost.
MOTIONAI_SECURE_COOKIES=0
MOTIONAI_ALLOWED_HOSTS=localhost,127.0.0.1,::1
MOTIONAI_PORT=3000
