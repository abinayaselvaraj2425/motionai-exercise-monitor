# Local development: copy this file to .env. Never commit your real .env.
MOTIONAI_ENV=local
MOTIONAI_PORT=3000
# Optional local canonical origin; leave blank to support localhost ports.
MOTIONAI_PUBLIC_URL=

# Optional Google OAuth web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave blank to derive from the public URL or the local launch port.
GOOGLE_REDIRECT_URI=

# Optional AI connection. Built-in MotionAI help works without these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Hosted deployments: set these in the host's environment, not a public repo.
# MOTIONAI_ENV=production
# MOTIONAI_PUBLIC_URL=https://your-motionai-domain.example
# MOTIONAI_AUTH_DB=/var/data/accounts.sqlite
# MOTIONAI_USER_DATA_DIR=/var/data/users
# MOTIONAI_DB=/var/data/system.sqlite
# MOTIONAI_REQUIRE_MODEL=1
# FORWARDED_ALLOW_IPS=127.0.0.1
# Only trust all forwarded headers when the platform exposes this service
# exclusively through its own trusted reverse proxy (Render template does this).
